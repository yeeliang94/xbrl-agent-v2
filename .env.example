# XBRL Agent v2. Copy to .env and fill in what this machine needs.
# Only secrets, keys and the gateway address live here. Every other setting
# is on the Settings page.

# --- Models: direct (the Mac) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Models: gateway (the enterprise machine) ---
# Setting LLM_PROXY_URL switches every model to the gateway.
LLM_PROXY_URL=
LLM_PROXY_API_KEY=
# HTTPS_PROXY=

# --- Sign-in ---
# Production (WEBSITE_SITE_NAME set) refuses to start without SESSION_SECRET.
SESSION_SECRET=
# Creates an admin on start-up when both are set. An existing account is only promoted.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
# AUTH_MODE=dev signs everyone in as a local admin. Never in production.
# AUTH_MODE=
# The idle timeout and the lockout limits are on the Settings page.

# --- Server ---
HOST=
PORT=
# Where the database, uploads and transcripts live. Default: output/ in the project.
# XBRL_OUTPUT_DIR=
